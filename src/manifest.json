{
  "manifest_version": 3,
  "name": "Katch!",
  "version": "1.4.1",
  "description": "Smart QA & Testing Chrome Extension — catch bugs with edge-case payloads.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Katch!",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/serviceWorker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/contentScript.ts"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "webRequest",
    "clipboardWrite",
    "sidePanel"
  ],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["src/injected/networkHook.ts"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "open-katch": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open Katch! popup"
    }
  }
}
